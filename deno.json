{
  "lock": false,
  "imports": {
    "@standard-schema/spec": "jsr:@standard-schema/spec@^1",
    "@standard-schema/utils": "jsr:@standard-schema/utils@^0",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/bytes": "jsr:@std/bytes@^1",
    "@std/cli": "jsr:@std/cli@^1",
    "@std/collections": "jsr:@std/collections@^1",
    "@std/crypto": "jsr:@std/crypto@^1",
    "@std/encoding": "jsr:@std/encoding@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/io": "jsr:@std/io@^0",
    "@std/json": "jsr:@std/json@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/toml": "jsr:@std/toml@^1",
    "@std/xml": "jsr:@std/xml@^0",
    "@deno/wasmbuild": "jsr:@deno/wasmbuild@^0",
    "@zod/zod": "jsr:@zod/zod@^4"
  },
  "tasks": {
    "fix": "deno task format && deno lint --fix",
    "check": "deno task format:check && deno lint && deno check **/*.ts",
    "test": "RUST_BACKTRACE=1 deno test --unstable-http --unstable-webgpu --allow-all --parallel --coverage --trace-leaks",
    "test:inspect": "RUST_BACKTRACE=1 deno test --unstable-http --unstable-webgpu --allow-all --parallel --coverage --trace-leaks --inspect-wait",
    "cov:gen": "deno coverage coverage --lcov --output=cov.lcov",
    "build:wasm": "deno run --allow-read --allow-run _tools/build_wasm.ts",
    "build:wasm:check": "deno task build:wasm --check",
    "format:wasm": "cd _wasm && cargo fmt --all",
    "format:wasm:check": "cd _wasm && cargo fmt --all -- --check",
    "format": "deno fmt && deno task format:wasm",
    "format:check": "deno fmt --check && deno task format:wasm:check"
  },
  "workspace": [
    "./assert",
    "./collections",
    "./crypto",
    "./database",
    "./encoding",
    "./event",
    "./ffi",
    "./fs",
    "./http",
    "./json",
    "./lexer",
    "./types",
    "./validation",
    "./xml",
    "./zip"
  ],
  "exclude": [
    "./_wasm/target",
    "./coverage"
  ]
}
